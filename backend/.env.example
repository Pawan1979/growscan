# GrocScan Backend Environment Configuration Template

PORT=5000
NODE_ENV=development

# QuickCommerce Live API Key (e.g. sk_live_your_api_key_here)
QC_API_KEY=

# Cache TTL Configuration (in seconds)
# 21600 = 6 hours | 3600 = 1 hour | 1800 = 30 minutes | 600 = 10 minutes
CACHE_TTL_SECONDS=21600

# Preload Catalog Data Interval (in seconds)
PRELOAD_INTERVAL_SECONDS=21600

# Configurable Initial Popular Items (comma-separated list)
PRELOAD_POPULAR_ITEMS=Amul Taaza Milk 500ml,Tata Salt 1kg,Fortune Sunflower Oil 1L,Maggi 2-Minute Noodles,Aashirvaad Atta 5kg,Surf Excel Detergent Powder,Coca-Cola Soft Drink,Cadbury Dairy Milk Silk
